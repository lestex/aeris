# Pre/post snapper snapshots around every dnf transaction.
# Format: callback : pkg_filter : direction : options : command
# Spaces inside the command MUST be backslash-escaped.
pre_transaction::::/usr/bin/sh -c echo\ "tmp.snapper_pre_number=$(snapper\ -c\ root\ create\ -t\ pre\ -p\ -d\ dnf)"
post_transaction::::/usr/bin/sh -c [\ -n\ "${tmp.snapper_pre_number}"\ ]\ &&\ snapper\ -c\ root\ create\ -t\ post\ --pre-number\ "${tmp.snapper_pre_number}"\ -d\ dnf
