#!/bin/bash
# aeris-background — choose the wallpaper.
#
#   aeris-background list             what is available
#   aeris-background set <path>       use this image
#   aeris-background next             cycle to the next one
#   aeris-background clear            solid theme color instead
#   aeris-background current          print the active path
#
# Images are looked for in, in order:
#   ~/.local/share/aerisos/<theme>/backgrounds/   per-theme, imported
#   ~/Pictures/backgrounds/                       yours
#   <data root>/themes/<theme>/backgrounds/       from a checkout
#   <data root>/backgrounds/                      shipped
#
# The per-theme directory lives under XDG_DATA_HOME rather than beside the
# palettes in /usr/local/share, because `setup 70` replaces that tree
# wholesale on every run — 52 MB of wallpaper would be deleted and recopied
# each time, when it changes on a completely different schedule.
#
# The choice is written as plain text to ~/.local/state/aerisos/current/
# background. Omarchy uses a symlink there, which works because their shell
# polls it; a text file is watchable by Quickshell's FileView instead, so the
# wallpaper changes the moment this runs rather than on the next poll.
# Requires bash 4+ (mapfile). Fedora has bash 5; macOS ships 3.2, so test
# from a checkout on a Mac with brew's bash, not /bin/bash.
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/aerisos"
CURRENT="$STATE/current"
MARKER="$CURRENT/background"

die() { echo "aeris-background: $*" >&2; exit 1; }

resolve_root() {
  local self candidate
  self=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  for candidate in "${AERIS_ROOT:-}" /usr/local/share/aerisos "$self"; do
    [[ -n $candidate && -d $candidate/themes ]] || continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}
AERIS_ROOT=$(resolve_root) || die "cannot find the AerisOS data; set AERIS_ROOT"

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/aerisos"

search_dirs() {
  local theme
  theme=$(cat "$CURRENT/theme" 2>/dev/null || true)
  if [[ -n $theme ]]; then
    printf '%s\n' "$DATA/$theme/backgrounds"
    printf '%s\n' "$AERIS_ROOT/themes/$theme/backgrounds"
  fi
  printf '%s\n' "$HOME/Pictures/backgrounds"
  printf '%s\n' "$AERIS_ROOT/backgrounds"
}

cmd_list() {
  local dir
  while IFS= read -r dir; do
    [[ -d $dir ]] || continue
    find "$dir" -maxdepth 1 -type f \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
      2>/dev/null
  done < <(search_dirs) | sort -u
}

cmd_current() {
  [[ -s $MARKER ]] || { echo "none (solid theme color)"; return 0; }
  cat "$MARKER"
}

cmd_set() {
  local path=${1:-}
  [[ -n $path ]] || die "usage: aeris-background set <path>"
  path=$(readlink -f "$path") || die "cannot resolve: $path"
  [[ -f $path ]] || die "no such file: $path"

  mkdir -p "$CURRENT"
  printf '%s\n' "$path" >"$MARKER"
  echo "background: $path"
}

cmd_clear() {
  mkdir -p "$CURRENT"
  : >"$MARKER"
  echo "background cleared — solid theme color"
}

cmd_next() {
  local -a all
  mapfile -t all < <(cmd_list)
  (( ${#all[@]} )) || die "no images found; put some in ~/Pictures/backgrounds"

  local cur idx=-1 i
  cur=$(cat "$MARKER" 2>/dev/null || true)
  for i in "${!all[@]}"; do
    [[ ${all[i]} == "$cur" ]] && { idx=$i; break; }
  done

  cmd_set "${all[$(( (idx + 1) % ${#all[@]} ))]}"
}

case ${1:-} in
  list)    cmd_list ;;
  current) cmd_current ;;
  set)     shift; cmd_set "$@" ;;
  next)    cmd_next ;;
  clear)   cmd_clear ;;
  *)       sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
